<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF5"
    android:padding="24dp"
    tools:context=".VerifikasiActivity"> <TextView
    android:id="@+id/tvTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="48dp"
    android:text="Masuk Ke Aplikasi"
    android:textColor="#1E1E1E"
    android:textSize="24sp"
    android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Kode OTP Telah Dikirim Ke Ponsel Anda"
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/llResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvSubtitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kirim Ulang"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="\u21BB" android:textColor="#555555"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llOTPInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/llResend"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etOtp1"
            style="@style/OtpBoxStyle"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etOtp2"
            style="@style/OtpBoxStyle"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etOtp3"
            style="@style/OtpBoxStyle"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etOtp4"
            style="@style/OtpBoxStyle" />
    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelanjutnya"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:text="Selanjutnya"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        app:backgroundTint="#59946B" /> </RelativeLayout>