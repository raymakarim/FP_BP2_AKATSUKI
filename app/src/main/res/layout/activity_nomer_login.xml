<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF5"
    android:padding="24dp"
    tools:context=".NomerLogin">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:text="Masuk Ke Aplikasi"
        android:textColor="#1E1E1E"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Silahkan Tambahkan Informasi Anda Untuk Masuk"
        android:textColor="#555555"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/llToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvSubtitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Email"
            android:textColor="@color/black"
            android:layout_marginEnd="16dp"
            android:elevation="4dp"
            android:backgroundTint="@android:color/white" />

        <Button
            android:id="@+id/btnPonsel"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Ponsel"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:elevation="4dp"
            android:backgroundTint="#328E6E" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_input_background"
        android:padding="16dp"
        android:layout_below="@+id/llToggle"
        android:layout_marginTop="32dp"
        android:clipToOutline="true"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nomor Ponsel"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etNomor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="0815 9000 6767"
            android:background="@android:color/white"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:inputType="phone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMasuk"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:text="Masuk"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#59946B" />

</RelativeLayout>